{
  "name": "maatify/php-category",
  "description": "Framework-neutral hierarchical category and content domain with PDO persistence.",
  "keywords": [
    "category",
    "taxonomy",
    "hierarchy",
    "content",
    "mysql",
    "pdo",
    "php",
    "maatify"
  ],
  "homepage": "https://github.com/Maatify/php-category",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Maatify",
      "email": "support@maatify.com",
      "homepage": "https://maatify.dev"
    }
  ],
  "support": {
    "issues": "https://github.com/Maatify/php-category/issues",
    "source": "https://github.com/Maatify/php-category",
    "security": "https://github.com/Maatify/php-category/security/policy"
  },
  "autoload": {
    "psr-4": {
      "Maatify\\Category\\": "src/Category/",
      "Maatify\\Category\\Common\\": "src/Common/",
      "Maatify\\Category\\Content\\": "src/Content/",
      "Maatify\\Category\\ContentField\\": "src/ContentField/",
      "Maatify\\Category\\Facade\\": "src/Facade/",
      "Maatify\\Category\\Factory\\": "src/Factory/",
      "Maatify\\Category\\ImageAssignment\\": "src/ImageAssignment/",
      "Maatify\\Category\\ImageRole\\": "src/ImageRole/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Maatify\\Category\\Tests\\": "tests/"
    }
  },
  "require": {
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "maatify/exceptions": "^1.0",
    "maatify/persistence": "^1.3",
    "maatify/shared-common": "^1.0",
    "php": "^8.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.5"
  },
  "scripts": {
    "analyse": "phpstan analyse src tests --level=max --memory-limit=256M",
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.4.0"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
